# Copy this file to .env and fill in your real values.
# .env is git-ignored — it will never be committed.
# See README.md's "Setting up Google Drive sync" section for where these
# come from (Google Cloud Console → APIs & Services → Credentials).

GOOGLE_CLIENT_ID_ANDROID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# The site each tab opens (no trailing slash). See README.md's
# "Before you run it" section.
# The Manga tab's two sites: the first opens by default (series at
# /manga/<id>, chapters at /chapter/<id>); the second is in its ▾ site list
# (series at /title/<id>-<slug>).
MANGA_SITE_URL=https://your-manga-site.example.com
MANGA_SITE_2_URL=https://your-second-manga-site.example.com
# Third Manga site: series at /title/<uuid>, chapters at /chapter/<uuid>,
# details from its API at api.<site>.
MANGA_SITE_3_URL=https://your-third-manga-site.example.com
ANIME_SITE_URL=https://your-anime-site.example.com
# The Manhwa tab's three sites, searched in this order. The first is a
# Next.js comics site with series at /series/<id>; the second a WordPress
# manga-theme site with series at /serie/<slug>, whose Family Mode is kept
# on; the third a site with series at /series/<slug> and chapters at
# /series/<slug>/chapter-<n>. See README.md's "Before you run it" section.
MANHWA_SITE_URL=https://your-manhwa-site.example.com
MANHWA_SITE_2_URL=https://your-second-manhwa-site.example.com
MANHWA_SITE_3_URL=https://your-third-manhwa-site.example.com
